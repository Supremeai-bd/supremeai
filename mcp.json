{
  "$schema": "https://json.schemastore.org/mcp",
  "mcpServers": {
    "github-reader": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_READONLY_TOKEN}"
      }
    },
    "supremeai-control-tower": {
      "url": "https://supremeai-mcp-tower-live.onrender.com/mcp",
      "headers": {
        "Authorization": "Bearer ${SUPREMEAI_TOWER_TOKEN}"
      }
    },
    "supremeai-control-tower-sse": {
      "type": "sse",
      "url": "https://supremeai-mcp-tower-live.onrender.com/sse",
      "transport": "sse"
    },
    "supremeai-mcp-tower": {
      "command": "node",
      "args": [
        "F:/supremeai/infrastructure/mcp-control-plane/dist/index.js"
      ],
      "env": {
        "MCP_MODE": "stdio",
        "TINY_BRAIN_URL": "https://njelitltd-tiny-brain.hf.space"
      }
    }
  }
}
