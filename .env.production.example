# ==============================================================================
# SupremeAI — Production Docker Compose environment template
# ==============================================================================
# FIX(F-3): docker-compose.production.yml references `env_file: .env.production`
# (supremeai-backend + postgres services) and interpolates several variables at
# compose level. Neither this file nor any template was committed, so
# `docker compose -f docker-compose.production.yml up` aborted on a fresh host
# with "env file .env.production not found".
#
# Usage:
#   1. cp .env.production.example .env.production   (then fill in real values)
#   2. docker compose --env-file .env.production -f docker-compose.production.yml up -d
#
# SECURITY: never commit the real .env.production. Secrets come from the
# Infisical prod vault where available (see secrets/README.md). Canonical
# backend variable contract: specs/001-dynamic-production-configuration/contracts/config-contract.md
# ==============================================================================

# ── Compose interpolation (REQUIRED — compose fails fast if unset) ───────────
# R-04: VERSION must be a pinned release tag or image digest — `latest` is
# rejected by the compose file by design.
VERSION=
# Phase-4 fix (#125 / ROADMAP 4.1): canonical production DB contract — the
# backend engine (backend/core/db.py) reads SUPABASE_DATABASE_URL_POOLER first.
# Compose passes it through fail-fast; unset => `docker compose config` aborts
# with a clear message (never a silent wrong-DB or a late boot crash).
SUPABASE_DATABASE_URL_POOLER=
POSTGRES_USER=supremeai
# generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=supremeai
# generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# ── Backend runtime (loaded into supremeai-backend + postgres containers) ────
# The postgres official image reads POSTGRES_USER/PASSWORD/DB directly from
# this file. REDIS_URL is assembled by compose; the app DB DSN is the
# SUPABASE_DATABASE_URL_POOLER above (no local DATABASE_URL wiring anymore).
ENV=production
PORT=8080
# generate: python -c "import secrets; print(secrets.token_hex(64))"
SUPREMEAI_JWT_SECRET=
# Phase-4 fix (#125): HARD_REQUIRED_SECRETS boot contract
# (backend/core/security/secret_vault.py::_HARD_REQUIRED_SECRETS_BASELINE —
# absence aborts boot in production). The template previously missed all of
# these, so template-following deploys crashed on boot. The old
# SUPREMEAI_ENCRYPTION_KEY name was dead — the backend reads ENCRYPTION_KEY.
SUPABASE_URL=
SUPABASE_KEY=
# generate: python -c "import secrets; print(secrets.token_hex(64))"
ENCRYPTION_KEY=
SUPREMEAI_ADMIN_PASSWORD_HASH=
# generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUPREMEAI_API_KEY=
# Production URLs only — never "*" in production.
CORS_ORIGINS=["https://<frontend-url>"]
USER_CORS_ORIGINS=["https://supremeai-a.web.app","https://supremeai-lac.vercel.app","https://supremeai-studio.vercel.app"]
ADMIN_CORS_ORIGINS=["https://supremeai-admin.web.app"]
ALLOWED_HOSTS=<backend-host>

# ── Optional integrations (leave unset to disable the feature) ───────────────
# DATABASE_URL direct-env fallback exists in the engine (Render provisions it)
# but the compose stack no longer injects one — set only when deliberately
# overriding the Supabase pooler contract.
# DATABASE_URL=
# OTEL_EXPORTER_OTLP_ENDPOINT=   # set only when --profile observability is used
# FIREBASE_SERVICE_ACCOUNT_JSON=
# MCP_API_KEY=
# WORKER_AUTH_TOKEN=
