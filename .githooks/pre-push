#!/usr/bin/env bash
# SupremeAI pre-push hook — OpenAPI contract breaking-change gate (#1711).
# Intentional breaking changes require an admin-reviewed commit trailer:
#   contract-break-approved: <reason / reviewer / ticket>
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
if command -v python3 >/dev/null 2>&1; then
    PY=python3
else
    PY=python
fi

"$PY" "$REPO_ROOT/scripts/ci/openapi_breaking_guard.py" --check
