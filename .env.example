# Seconds the relay's preferred tier may run alone before the backup tier is started concurrently (hedged request). 0 disables hedging and restores strictly serial behaviour. Fast answers never trigger the backup, so quota use is unchanged in the common case.
SUPREMEAI_RELAY_HEDGE_AFTER_S=

# Answer closed-set greetings/thanks from a template with no model call, no persistence and no context injection. Defaults ON in production and OFF elsewhere so self-hosted and test deployments keep model behaviour deterministic.
SUPREMEAI_TRIVIAL_FASTPATH=

# Floor for the stealth-relay socket timeout. Prevents a tight per-model latency budget from handing the upstream a sub-second timeout, which would record a healthy-but-slow relay as a failure.
