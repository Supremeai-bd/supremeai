# SupremeAI API Gateway — env টেমপ্লেট (placeholder-ONLY)
# বাংলা নীতি: প্রকৃত মান Infisical vault থেকে আসবে — এই ফাইলে কখনো প্রকৃত key নয়।
# vault রেফারেন্স নামকরণ: <PROVIDER>_<PURPOSE> (infra রেপো SECRETS_MODEL §৮-সংগত)

# ১) key-plane ঐক্য (P1) — monolith api_keys টেবিল = SSOT (read-only mirror)
#    বাংলা: হ্যাশ-secret monolith-এর হুবহু একই (hash_api_key সমতা)
#    vault-ref: API_KEY_SIGNING_SECRET
API_KEY_SIGNING_SECRET=__VAULT:API_KEY_SIGNING_SECRET__
#    বাংলা: monolith Postgres-এর read-only সংযোগ (api_keys টেবিল কেবল পড়া হয়)
#    vault-ref: SUPABASE_DATABASE_URL_POOLER
KEYPLANE_DATABASE_URL=__VAULT:SUPABASE_DATABASE_URL_POOLER__

# ২) Provider credential — vault রেফারেন্স (মান vault-ই ধারণ করে)
#    vault-ref: GEMINI_API_KEY
GEMINI_API_KEY=__VAULT:GEMINI_API_KEY__
#    vault-ref: GROQ_API_KEY
GROQ_API_KEY=__VAULT:GROQ_API_KEY__

# ৩) অপারেশনাল
GATEWAY_CONFIG=config/routing_policy.example.json
GATEWAY_USAGE_LOG=/tmp/supremeai_api_usage.jsonl

# ৪) Render boot-identity (P2) — infisical_bootstrap.py এগুলো দিয়েই vault-pull করে
#    vault-ref: INFISICAL_CLIENT_ID / INFISICAL_CLIENT_SECRET (machine identity)
#    vault-ref: INFISICAL_PROJECT_ID = 92aa20c4-aef5-4e33-82bd-efb06058aaf0 (প্রকৃত মান vault-এ)
INFISICAL_PROJECT_ID=__VAULT:INFISICAL_PROJECT_ID__
INFISICAL_ENV=prod
INFISICAL_CLIENT_ID=__VAULT:INFISICAL_CLIENT_ID__
INFISICAL_CLIENT_SECRET=__VAULT:INFISICAL_CLIENT_SECRET__

# Dedicated operator telemetry credential; never reuse a client API key.
SUPREMEAI_OPERATOR_KEY=__VAULT:SUPREMEAI_OPERATOR_KEY__
